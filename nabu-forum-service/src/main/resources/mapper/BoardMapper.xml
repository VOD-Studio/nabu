<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfy.nabu.forum.mapper.BoardMapper">

    <resultMap id="BoardResultMap" type="com.xfy.nabu.forum.domain.BoardEntity">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="Columns">
        id, name, description, created_at, updated_at, deleted
    </sql>

    <select id="selectById" resultMap="BoardResultMap">
        select <include refid="Columns"/> from t_board where id = #{id} and deleted = 0
    </select>

    <select id="listAll" resultMap="BoardResultMap">
        select <include refid="Columns"/> from t_board where deleted = 0 order by id asc
    </select>

    <insert id="insert" parameterType="com.xfy.nabu.forum.domain.BoardEntity" useGeneratedKeys="true" keyProperty="id">
        insert into t_board (name, description)
        values (#{name}, #{description})
    </insert>

</mapper>
