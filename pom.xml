<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.xfy.nabu</groupId>
    <artifactId>nabu</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>nabu</name>
    <description>
        Nabu：Java 21 + Spring Boot 3.5 + Dubbo 3.3 + Spring Cloud Alibaba 全家桶 + RustFS 微服务项目，覆盖企业级 Java 微服务常见技术模式。
    </description>

    <modules>
        <module>nabu-common</module>
        <module>nabu-api</module>
        <module>nabu-auth-service</module>
        <module>nabu-user-service</module>
        <module>nabu-forum-service</module>
        <module>nabu-social-service</module>
        <module>nabu-notify-service</module>
        <module>nabu-search-service</module>
        <module>nabu-file-service</module>
        <module>nabu-moderation-service</module>
        <module>nabu-stat-service</module>
        <module>nabu-task-service</module>
        <module>nabu-admin-service</module>
        <module>nabu-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 版本线：官方矩阵 Spring Boot 3.5.x <-> Spring Cloud 2025.0.x <-> Spring Cloud Alibaba 2025.0.0.x -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <!-- RPC -->
        <dubbo.version>3.3.6</dubbo.version>

        <!-- 数据访问 -->
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <druid.version>1.2.28</druid.version>

        <!-- 缓存 -->
        <jetcache.version>2.7.9</jetcache.version>

        <!-- 消息队列 -->
        <rocketmq-spring.version>2.3.5</rocketmq-spring.version>

        <!-- 分布式事务：新版 Apache Seata groupId 已迁移为 org.apache.seata -->
        <seata.version>2.5.0</seata.version>

        <!-- 工具类 -->
        <fastjson2.version>2.0.65</fastjson2.version>
        <ttl.version>2.14.5</ttl.version>
        <jjwt.version>0.12.7</jjwt.version>

        <!-- 对象存储：RustFS 兼容 S3 API，使用 AWS SDK for Java v2 -->
        <aws-sdk-java.version>2.29.52</aws-sdk-java.version>

        <!-- 测试 -->
        <testcontainers.version>1.20.6</testcontainers.version>

        <!-- 代码格式化：Spotless（用法见 README 的「代码格式化」一节） -->
        <spotless.version>3.10.2</spotless.version>
        <palantir-java-format.version>2.98.0</palantir-java-format.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              显式最先导入 spring-boot-dependencies：锁定 Spring Framework 6.2.x / Boot 3.5.6 这一版本线。
              必须排在 dubbo-bom 之前——dubbo-bom 会把 spring-webmvc/spring-web/spring-beans 的
              管理版本设成 5.3.39（Dubbo 的 Spring5 基线），而子 pom 里靠前的 dependencyManagement 导入
              优先级高于父 pom(spring-boot-starter-parent) 的继承管理，若不抢先声明，web 层会退化到
              Spring5(javax.servlet)，导致 HandlerInterceptor 等 jakarta 签名实现报“不会覆盖超类型方法”。
              dubbo-bom 仍继续负责它自己的 org.apache.dubbo:* 版本，二者不冲突。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba：Nacos / Sentinel / Seata / RocketMQ 等的版本对齐由此统一管理 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Dubbo -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JetCache -->
            <dependency>
                <groupId>com.alicp.jetcache</groupId>
                <artifactId>jetcache-bom</artifactId>
                <version>${jetcache.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- AWS SDK v2 BOM：用于对接 RustFS 的 S3 兼容 API -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.xfy.nabu</groupId>
                <artifactId>nabu-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xfy.nabu</groupId>
                <artifactId>nabu-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Dubbo Spring Boot 生态（不在 dubbo-bom 内，需单独声明版本） -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-nacos-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>

            <!-- MyBatis -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- Druid -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- RocketMQ Spring -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>

            <!-- Seata：Apache 孵化后 groupId 迁移为 org.apache.seata -->
            <dependency>
                <groupId>org.apache.seata</groupId>
                <artifactId>seata-spring-boot-starter</artifactId>
                <version>${seata.version}</version>
            </dependency>

            <!-- Fastjson2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- TTL：跨线程上下文传播 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              统一代码格式化，对标 biome cli 的用法：
                mvn spotless:apply   # 格式化全部代码，对标 biome format -w
                mvn spotless:check   # 只校验不改文件，CI 门禁，对标 biome check
              只在这里声明一次，14 个模块自动继承，各自的 src/main/java、src/test/java 都会被处理。
              默认不绑定到 build 生命周期，格式化是显式动作；需要门禁时把下面的 check execution 打开即可。
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <!-- 固定 UNIX(LF) 换行，不受 .gitattributes / 操作系统默认换行影响 -->
                    <lineEndings>UNIX</lineEndings>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                            <!-- PALANTIR = 4 空格缩进 / 120 列，与仓库现状一致；另有 GOOGLE(2 空格/100) 与 AOSP(4 空格/100) -->
                            <style>PALANTIR</style>
                            <!-- 不重排 Javadoc：本项目注释大量中文，重排会产生无意义的大 diff -->
                            <formatJavadoc>false</formatJavadoc>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <!-- 需要临时豁免某段代码时，用 // @formatter:off / // @formatter:on 包住 -->
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <!-- 打开后 mvn validate/verify 会自动做格式门禁
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                    -->
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
