# =====================================================================================
# Nabu Docker Compose 环境变量模板（可入库，只放占位口令）。
#
# 用法：cp deploy/.env.example deploy/.env 后按需修改；deploy/.env 已被 .gitignore 忽略，
#      首次执行 deploy/scripts/{up,down,logs}.sh 时若缺少 .env 会自动复制本文件生成。
# 注意：本地已经起过 MySQL（存在 deploy/data/mysql-*）时，不要用本模板覆盖现有 .env，
#      口令与已有数据卷不一致会导致容器与服务端认证失败。
#
# 约定：这里的值是"容器网络内"的地址（服务名:端口）；
#      每个 Java 服务 application.yml 里的默认值则是"裸机直接跑 jar 时"的地址（127.0.0.1:端口），
#      两者不冲突——用 docker compose 启动时会用本文件覆盖为容器网络地址。
# =====================================================================================

# ---- Nacos（注册中心 + 配置中心）----
# application.yml 会补上 :8848，此处只填写主机名。
NACOS_ADDRESS=nacos
NACOS_NAMESPACE=
# 服务端鉴权总开关（compose.middleware.yml 会翻译成 -Dnacos.core.auth.enabled），默认开。
# 只在需要临时绕过时改成 false。
NACOS_AUTH_ENABLE=true
# 开鉴权后所有客户端（Java 服务、Seata TC）都必须带账号。用户名用内置的 nacos：
# 该版本只允许它持有 ROLE_ADMIN，给别的用户绑 ROLE_ADMIN 会静默失败（返 200、不落库）。
# 注意：本文件的值不会直接改到服务端。全新环境首次启动时，Nacos 数据目录里
# 一个用户都没有（不存在默认口令 nacos），必须用首任管理员自助接口建号：
#   curl -X POST 'http://127.0.0.1:8848/nacos/v3/auth/user' \
#     -d 'username=nacos' -d 'password=<与下面 NACOS_PASSWORD 一致>'
# 该接口仅在当前无管理员时开放；已有管理员时需登录后用管理接口改密。详见 README。
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos
# 下面三项是服务端签名/节点互信密钥，不是登录口令，但【必填】：
# compose.middleware.yml 用 ${VAR:-默认值} 读取，留空不会报错，而是静默回落到
# 仓库里公开写着的 dev-only 默认密钥——等于鉴权开了但签名密钥人尽皆知。
# NACOS_AUTH_TOKEN 要求 Base64 且解码后明文 >= 32 字节，否则 Nacos 启动期直接失败。
#   openssl rand -base64 48
NACOS_AUTH_TOKEN=
#   openssl rand -hex 8
NACOS_AUTH_IDENTITY_KEY=
#   openssl rand -base64 18
NACOS_AUTH_IDENTITY_VALUE=

# ---- Sentinel Dashboard ----
# 面板自身登录：用户名固定 admin，口令由 compose.middleware.yml 以 ${VAR:?} 强制注入。
SENTINEL_DASHBOARD=sentinel-dashboard:8858
SENTINEL_AUTH_PASSWORD=change-me-sentinel

# ---- Seata（分布式事务）----
SEATA_ADDRESS=seata-server:8091

# ---- RocketMQ ----
ROCKETMQ_NAMESRV=rmqnamesrv:9876

# ---- Redis（单实例多 database，各服务用不同 database 隔离）----
REDIS_HOST=redis
REDIS_PORT=6379
# 单实例已开 requirepass（compose.infrastructure.yml 用 ${REDIS_PASSWORD:?} 强制非空，留空会在 up 阶段中断）。
# 裸机跑服务前先 source deploy/scripts/dev-env.sh 把它导出到当前 shell。
REDIS_PASSWORD=change-me-redis

# ---- MySQL：按域拆分为独立容器实例，业务账号统一 admin，口令自行修改 ----
# 口令留空会在 compose 解析阶段 fail-fast；账号名与 compose.infrastructure.yml
# 里的 ${MYSQL_x_USERNAME:-admin} 兜底、各服务 application.yml 默认值保持一致。
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER_HOST=mysql-user
MYSQL_USER_PORT=3306
MYSQL_USER_USERNAME=admin
MYSQL_USER_PASSWORD=change-me-nabu
MYSQL_FORUM_HOST=mysql-forum
MYSQL_FORUM_PORT=3306
MYSQL_FORUM_USERNAME=admin
MYSQL_FORUM_PASSWORD=change-me-nabu
MYSQL_NOTIFY_HOST=mysql-notify
MYSQL_NOTIFY_PORT=3306
MYSQL_NOTIFY_USERNAME=admin
MYSQL_NOTIFY_PASSWORD=change-me-nabu
MYSQL_FILE_HOST=mysql-file
MYSQL_FILE_PORT=3306
MYSQL_FILE_USERNAME=admin
MYSQL_FILE_PASSWORD=change-me-nabu
MYSQL_MODERATION_HOST=mysql-moderation
MYSQL_MODERATION_PORT=3306
MYSQL_MODERATION_USERNAME=admin
MYSQL_MODERATION_PASSWORD=change-me-nabu

# ---- Elasticsearch ----
ELASTICSEARCH_URIS=http://elasticsearch:9200

# ---- RustFS（S3 兼容对象存储）----
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key
RUSTFS_BUCKET=nabu-files

# ---- JWT 签名密钥（只有 nabu-auth-service 读取，其余服务经 Dubbo 委托验签）----
# 这是 HMAC 密钥不是口令，不能填 change-me 这类短串：jjwt 的 hmacShaKeyFor 对 <256bit 密钥直接抛
# WeakKeyException，auth-service 会启动失败。生成 512-bit 密钥：
#   openssl rand -base64 64
# 改它会使已签发的 access/refresh token 全部失效。
JWT_SECRET=change-me-openssl-rand-base64-64

# ---- Grafana（可观测性面板，登录用户名固定 admin）----
# 由 compose.observability.yml 以 ${VAR:?} 强制注入。
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- Druid 监控台（/druid 页面，登录用户名固定 admin）----
# 只有 user/forum/file/notify/moderation 五个服务开了 Druid 监控，
# compose.app.yml 仅向这五个容器注入本变量。
DRUID_MONITOR_PASSWORD=change-me-druid

# ---- 应用容器资源与 JVM 旋钮（compose.app.yml 引用；留空则用 compose 里的默认值）----
# 单容器内存上限。Docker VM 只有 ~5.8G 时，12 个全起会超卖，按需起或调小这个值。
#APP_MEM_LIMIT=1g
# JVM 参数：MaxRAMPercentage 按容器上限自适应堆大小；ExitOnOutOfMemoryError 让 OOM 的
# 容器立即退出、交给 restart 策略重启，而不是把整个 Docker VM 拖垮。
#JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
