<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xfy.nabu.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.xfy.nabu.user.domain.UserEntity">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="level" column="level"/>
        <result property="points" column="points"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <sql id="Columns">
        id, username, password_hash, nickname, avatar, level, points, status, created_at, updated_at, deleted
    </sql>

    <select id="selectById" resultMap="UserResultMap">
        select <include refid="Columns"/> from t_user where id = #{id} and deleted = 0
    </select>

    <select id="selectByIds" resultMap="UserResultMap">
        select <include refid="Columns"/> from t_user
        where deleted = 0 and id in
        <foreach collection="ids" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
    </select>

    <select id="selectByUsername" resultMap="UserResultMap">
        select <include refid="Columns"/> from t_user where username = #{username} and deleted = 0
    </select>

    <insert id="insert" parameterType="com.xfy.nabu.user.domain.UserEntity" useGeneratedKeys="true" keyProperty="id">
        insert into t_user (username, password_hash, nickname, avatar, level, points, status)
        values (#{username}, #{passwordHash}, #{nickname}, #{avatar}, #{level}, #{points}, #{status})
    </insert>

    <update id="changePoints">
        update t_user
        set points = points + #{delta}
        where id = #{id} and deleted = 0 and points + #{delta} >= 0
    </update>

</mapper>
